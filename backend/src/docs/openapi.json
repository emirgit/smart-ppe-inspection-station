{
  "openapi": "3.0.3",
  "info": {
    "title": "PPE Inspection Station API",
    "description": "REST API contract for Admin Panel and Raspberry Pi integration in the PPE inspection turnstile system.",
    "version": "1.4.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local reference server"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "Admin authentication (signup, login, me)" },
    { "name": "Health", "description": "Service health checks" },
    { "name": "Workers", "description": "Worker management endpoints" },
    { "name": "Roles", "description": "Role and role-PPE requirements" },
    { "name": "PPE Items", "description": "Master PPE item catalog" },
    { "name": "Entry Logs", "description": "Inspection log ingestion and querying" },
    { "name": "RFID", "description": "Public RFID scan endpoints" }
  ],
  "paths": {
    "/api/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new admin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SignUpRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Admin created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login and get JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get current admin profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current admin profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminProfileResponse" }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "timestamp": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/workers": {
      "get": {
        "tags": ["Workers"],
        "summary": "List workers",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "is_active",
            "schema": { "type": "boolean" },
            "required": false,
            "description": "Filter by active status"
          },
          {
            "in": "query",
            "name": "role_id",
            "schema": { "type": "integer" },
            "required": false,
            "description": "Filter by role ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Workers list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WorkersListResponse" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Workers"],
        "summary": "Create worker",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateWorkerRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Worker created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WorkerSingleResponse" }
              }
            }
          },
          "404": {
            "description": "Role not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "409": {
            "description": "RFID already registered",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/workers/digital-twin/{id}": {
      "get": {
        "tags": ["Workers"],
        "summary": "Get worker digital twin",
        "description": "Returns aggregated compliance stats and the latest 10 entry logs for the worker.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Digital twin data",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WorkerDigitalTwinResponse" }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "404": {
            "description": "Worker not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/workers/{id}": {
      "get": {
        "tags": ["Workers"],
        "summary": "Get worker by ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Worker found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WorkerSingleResponse" }
              }
            }
          },
          "404": {
            "description": "Worker not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Workers"],
        "summary": "Partially update worker",
        "description": "Updates worker details. If an inactive worker is assigned a new `rfid_card_uid`, they will be automatically reactivated (`is_active` set to `true`).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateWorkerRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Worker updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WorkerSingleResponse" }
              }
            }
          },
          "404": {
            "description": "Worker not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "409": {
            "description": "Conflict error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Workers"],
        "summary": "Soft-delete worker (deactivate)",
        "description": "Sets `is_active` to `false` and clears `rfid_card_uid` to `null` so the RFID card can be re-assigned. The worker record is **not** removed from the database.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Worker deactivated and RFID card released",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Worker deactivated" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "integer", "example": 1 },
                        "is_active": { "type": "boolean", "example": false }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "404": {
            "description": "Worker not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/workers/{id}/permanent": {
      "delete": {
        "tags": ["Workers"],
        "summary": "Hard-delete worker (permanent)",
        "description": "Permanently removes the worker record from the database. If the worker has a profile photo stored in Cloudflare R2, the object is deleted first. **This action is irreversible.**",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "Worker ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Worker permanently deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Worker permanently deleted" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "integer", "example": 1 }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "404": {
            "description": "Worker not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/workers/{id}/photo": {
      "post": {
        "tags": ["Workers"],
        "summary": "Upload or replace worker profile photo",
        "description": "Uploads a profile photo to Cloudflare R2 and saves the public URL in `photo_url`. If the worker already has a photo, the old object is deleted from R2 first. Accepts `multipart/form-data` with a single field named `photo`.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "Worker ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["photo"],
                "properties": {
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Image file (JPEG, PNG, or WebP — max 5 MB)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Photo uploaded; returns updated worker object with new `photo_url`",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WorkerSingleResponse" }
              }
            }
          },
          "400": {
            "description": "No file provided",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "404": {
            "description": "Worker not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "415": {
            "description": "Unsupported media type (only JPEG, PNG, WebP allowed)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Workers"],
        "summary": "Delete worker profile photo",
        "description": "Removes the photo object from Cloudflare R2 and sets `photo_url` to null in the database.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "Worker ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Photo deleted; returns updated worker object with `photo_url: null`",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WorkerSingleResponse" }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "404": {
            "description": "Worker not found, or worker has no profile photo",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/workers/card/{uid}": {
      "get": {
        "tags": ["Workers"],
        "summary": "Validate RFID card and fetch worker PPE requirements",
        "description": "Critical RPi endpoint (inspection flow step 2).",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "RFID card UID"
          }
        ],
        "responses": {
          "200": {
            "description": "Registered card",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WorkerCardLookupResponse" }
              }
            }
          },
          "404": {
            "description": "Card not registered",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/rfid/scan": {
      "post": {
        "tags": ["RFID"],
        "summary": "Store latest RFID scan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RfidScanRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "RFID scan stored",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RfidScanResponse" }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["RFID"],
        "summary": "Get latest RFID scan",
        "responses": {
          "200": {
            "description": "Latest RFID scan",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RfidScanResponse" }
              }
            }
          },
          "404": {
            "description": "No RFID scan found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/roles": {
      "get": {
        "tags": ["Roles"],
        "summary": "List roles",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Roles list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RolesListResponse" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Roles"],
        "summary": "Create role",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateRoleRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Role created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RoleSingleResponse" }
              }
            }
          },
          "409": {
            "description": "Role already exists",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/roles/{id}/ppe": {
      "get": {
        "tags": ["Roles"],
        "summary": "Get required PPE for role",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Role PPE requirements",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RolePpeResponse" }
              }
            }
          },
          "404": {
            "description": "Role not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Roles"],
        "summary": "Replace PPE requirements for role",
        "description": "Replace operation: submitted list fully replaces existing role PPE requirements.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ppe_item_ids"],
                "properties": {
                  "ppe_item_ids": {
                    "type": "array",
                    "items": { "type": "integer" },
                    "example": [1, 2, 3]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated role PPE requirements",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RolePpeResponse" }
              }
            }
          },
          "404": {
            "description": "Role not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/ppe-items": {
      "get": {
        "tags": ["PPE Items"],
        "summary": "List all PPE items",
        "description": "item_key values should match AI model class labels exactly.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "PPE item list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PpeItemsListResponse" }
              }
            }
          }
        }
      }
    },
    "/api/ppe-items/{id}": {
      "get": {
        "tags": ["PPE Items"],
        "summary": "Get PPE item by ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "PPE item found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PpeItemSingleResponse" }
              }
            }
          },
          "404": {
            "description": "PPE item not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/entry-logs": {
      "post": {
        "tags": ["Entry Logs"],
        "summary": "Create inspection entry log",
        "description": "Critical RPi endpoint (inspection flow step 6).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateEntryLogRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Entry log created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EntryLogCreateResponse" }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["Entry Logs"],
        "summary": "List entry logs",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "query", "name": "worker_id", "schema": { "type": "integer" }, "required": false },
          {
            "in": "query",
            "name": "result",
            "schema": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN_CARD"] },
            "required": false
          },
          {
            "in": "query",
            "name": "start_date",
            "schema": { "type": "string", "format": "date" },
            "required": false
          },
          {
            "in": "query",
            "name": "end_date",
            "schema": { "type": "string", "format": "date" },
            "required": false
          },
          { "in": "query", "name": "limit", "schema": { "type": "integer", "default": 50 }, "required": false },
          { "in": "query", "name": "offset", "schema": { "type": "integer", "default": 0 }, "required": false }
        ],
        "responses": {
          "200": {
            "description": "Entry log list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EntryLogsListResponse" }
              }
            }
          }
        }
      }
    },
    "/api/entry-logs/stats": {
      "get": {
        "tags": ["Entry Logs"],
        "summary": "Get compliance dashboard stats",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "start_date",
            "schema": { "type": "string", "format": "date" },
            "required": false
          },
          {
            "in": "query",
            "name": "end_date",
            "schema": { "type": "string", "format": "date" },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Compliance statistics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EntryLogStatsResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
